#include<iostream>
int main()
{
    int t;
    std::cin>>t;
    for(int i=0;i<t;i++)
    {
        int rating;
        std::cin>>rating;
        if(rating>=1900)
        std::cout<<"Division 1";
        else if(rating>=1600 && rating<=1899)
        std::cout<<"Division 2";
        else if(rating>=1400 && rating<=1599)
        std::cout<<"Division 3";
        else
        std::cout<<"Division 4";
        std::cout<<std::endl;
    }
}